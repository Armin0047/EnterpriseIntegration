{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER;Database=YOUR_DATABASE;User Id=YOUR_SQL_USER;Password=REPLACE_ME;Encrypt=True;TrustServerCertificate=False"
  },
  "PartnerAuth": {
    "ClientSecretHash": "REPLACE_WITH_64_HEX_CHAR_SHA256_HASH"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES",
    "Issuer": "EnterpriseIntegration",
    "Audience": "EnterpriseIntegrationClient",
    "ExpiryMinutes": 1440
  },
  "AllowedHosts": "*"
}
